# Copy to .env in this folder (never commit .env).
# Must be https:// - the shipper refuses to send the key over plain HTTP.
INGEST_URL=https://your-app.fastapicloud.dev/ingest
# Exactly the same value as INGEST_API_KEY in the API's environment.
INGEST_API_KEY=replace-with-the-same-value-set-in-fastapi-cloud
