# Copy to .env (never commit .env) and fill in real values.
# Generate every secret below with:
#   python -c "import secrets; print(secrets.token_hex(32))"

# Atlas connection string for a database user that has readWrite on the
# honeypot database ONLY (not atlasAdmin) - see the setup guide, Step 0.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=honeypot

# Two DIFFERENT values. The app refuses to start if they match, if either
# is shorter than 32 characters, or if either still starts with "replace-".
INGEST_API_KEY=replace-with-a-long-random-string
JWT_SECRET_KEY=replace-with-a-different-long-random-string
JWT_EXPIRE_MINUTES=60

# Your real frontend URL in production (Firebase Hosting), no trailing slash.
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Number of reverse proxies in front of the API that append to
# X-Forwarded-For. 0 for local dev. On FastAPI Cloud, check the setup
# guide ("Rate limiting behind a proxy") before changing this.
TRUSTED_PROXY_HOPS=0

# Raw events older than this many days are deleted automatically (keeps the
# free Atlas tier from filling up). 0 = keep forever.
RAW_EVENT_RETENTION_DAYS=30

# Interactive API docs at /docs. Keep false in production.
ENABLE_API_DOCS=false
